API_KEY=test-api-key-12345
PORT=3000
NODE_ENV=development
MINI_BUCKET_URL=http://149.130.164.187:2020

# Timeout configurations (in milliseconds)
# wkhtmltopdf timeout - default 4 minutes
WKHTMLTOPDF_TIMEOUT_MS=240000
# Ghostscript timeout - default 2 minutes
GHOSTSCRIPT_TIMEOUT_MS=120000
# Fastify request timeout - default 6 minutes
REQUEST_TIMEOUT_MS=360000
# Fastify connection timeout - 0 means no timeout
CONNECTION_TIMEOUT_MS=0

# Performance optimization
# Set to true to skip two-pass HTML rendering for faster PDF generation
# This will use source PDF dimensions or fallback heights instead of auto-detecting content height
SKIP_HTML_AUTO_HEIGHT=false
